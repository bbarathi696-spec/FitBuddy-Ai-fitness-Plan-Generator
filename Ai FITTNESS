import numpy as np
import joblib
import os

class MLPipeline:
    def __init__(self, model_path="models/baseline_model.pkl"):
        self.model_path = model_path
        self.model = self._load_model()

    def _load_model(self):
        """Epic 1: Load architecture/weights safely"""
        if os.path.exists(self.model_path):
            return joblib.load(self.model_path)
        else:
            # Mock model fallback if no weight file exists yet
            class MockModel:
                def predict(self, X): return np.array([1 if np.sum(X) > 0 else 0])
            return MockModel()

    def preprocess(self, raw_data: list) -> np.ndarray:
        """Epic 2: Core preprocessing matrix transformation"""
        # Example processing: scaling or reshaping input arrays
        features = np.array(raw_data).reshape(1, -1)
        return features

    def predict(self, raw_input: list) -> dict:
        """Epic 2: Execution block matching model outputs to user targets"""
        try:
            processed_features = self.preprocess(raw_input)
            prediction = self.model.predict(processed_features)[0]
            
            # Map predictions dynamically
            result_map = {0: "Negative/Class A", 1: "Positive/Class B"}
            return {
                "status": "success",
                "class_id": int(prediction),
                "label": result_map.get(prediction, "Unknown")
            }
        except Exception as e:
            return {"status": "error", "message": str(e)}
